{
  "$schema": "../../../../../release-readiness/config.schema.json",
  "profile": "python",
  "version": {
    "sources": [
      {
        "type": "regex",
        "path": "src/synthetic_pkg/__init__.py",
        "pattern": "^__version__\\s*=\\s*[\"'](?P<version>[^\"']+)[\"']"
